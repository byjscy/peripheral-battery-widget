<Window x:Class="BatteryWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外设电量设置" Width="484" Height="568" MinHeight="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF2FB"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EDF2FB"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,12,5"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Width" Value="64"/><Setter Property="Height" Value="27"/>
      <Setter Property="Background" Value="#E7ECF6"/><Setter Property="Foreground" Value="#171E2D"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="FieldSurface" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#AAC2D9">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="#3275D1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F0F5FF"/><Setter Property="Background" Value="#48546B"/>
      <Setter Property="Padding" Value="16,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E4F0FF"/>
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24">
              <Border Height="5" Background="#79879E" CornerRadius="3" Margin="8,0"/>
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Focusable="False" Command="Slider.DecreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"><Border Height="5" Background="#8DBBFF" CornerRadius="3" Margin="8,0,-2,0"/></Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#F0F5FF" Stroke="#8CB9F9" StrokeThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Focusable="False" Command="Slider.IncreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="#28CDD9EE"/><Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="13,9"/><Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="#27E5EDFC"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <Border Margin="5" CornerRadius="26" BorderBrush="#7C8AA3" BorderThickness="1" Background="#252D3E" Padding="17,13,17,13">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Background="Transparent" MouseLeftButtonDown="DragTitle" Margin="2,0,0,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}" Padding="9,4" Content="×"
                FontSize="16" Background="#364055" Click="CloseClick" ToolTip="取消并关闭"/>
        <TextBlock Text="外设电量设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
        <StackPanel>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <TextBlock Text="外观与大小" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="不透明度" VerticalAlignment="Center"/>
                <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="20" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OpacitySliderChanged" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="不透明度滑条"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <TextBox x:Name="OpacityInput" TextChanged="OpacityInputChanged" MaxLength="3" AutomationProperties.Name="不透明度百分比"/>
                  <TextBlock Text="%" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="卡片宽度" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="恢复自动高度" Style="{StaticResource RoundedButton}" Padding="10,4"
                        HorizontalAlignment="Left" Click="ResetHeightClick" x:Name="ResetHeightButton"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <TextBox x:Name="WidthInput" MaxLength="3" AutomationProperties.Name="卡片宽度"/>
                  <TextBlock Text="px" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <WrapPanel>
                <CheckBox x:Name="TopmostCheck" Content="始终置顶"/>
                <CheckBox x:Name="LockCheck" Content="锁定位置"/>
                <CheckBox x:Name="StartupCheck" Content="开机启动"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <TextBlock Text="刷新与提醒" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <DockPanel Margin="0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBox x:Name="RefreshInput" MaxLength="4" AutomationProperties.Name="自动刷新间隔"/>
                  <TextBlock Text="秒" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="自动刷新间隔" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,4">
                <ComboBox x:Name="ThresholdInput" DockPanel.Dock="Right" Width="86" Height="27"
                          AutomationProperties.Name="低电量阈值"/>
                <CheckBox x:Name="NotifyCheck" Content="低电量通知" Margin="0"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <TextBlock Text="显示的设备" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <CheckBox x:Name="EarbudPartsCheck" Content="显示耳机左耳、右耳和充电仓电量"/>
              <ItemsControl x:Name="DeviceOptions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible, Mode=TwoWay}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" LastChildFill="True" Margin="1,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="取消" Style="{StaticResource RoundedButton}" IsCancel="True" Margin="6,0,6,0"/>
          <Button Content="保存" Style="{StaticResource RoundedButton}" IsDefault="True" Click="SaveClick"
                  Background="#4075C9"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#FFB5A9" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
