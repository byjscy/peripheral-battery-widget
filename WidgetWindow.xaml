<Window x:Class="BatteryWidget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BatteryWidget"
        Title="外设电量" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E0E8F4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#35EBF4FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#53EBF4FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResizeGrip" TargetType="Thumb">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#01000000" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="DragStarted" Handler="ResizeStarted" />
      <EventSetter Event="DragDelta" Handler="ResizeMoved" />
      <EventSetter Event="DragCompleted" Handler="ResizeCompleted" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Panel" Background="Transparent" MouseRightButtonUp="CardMenuClick">
    <Grid x:Name="GlassSurface" Margin="4" SizeChanged="GlassSizeChanged">
      <Border Background="#EE202738" CornerRadius="28"/>
      <Image x:Name="Backdrop" Stretch="Fill" Opacity="0.81" IsHitTestVisible="False">
        <Image.Effect>
          <BlurEffect Radius="28" KernelType="Gaussian" RenderingBias="Performance" />
        </Image.Effect>
      </Image>
      <Border CornerRadius="28" BorderThickness="1" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
            <GradientStop Color="#A9273148" Offset="0"/>
            <GradientStop Color="#C7192234" Offset="0.58"/>
            <GradientStop Color="#D5191F2F" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#A5E7F0FF" Offset="0"/>
            <GradientStop Color="#5EBACAE2" Offset="0.48"/>
            <GradientStop Color="#426A7893" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <Grid Margin="15,13,15,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="DragHeader" Margin="1,0,1,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="35" Height="35" CornerRadius="13" Background="#35CEDFFF" BorderThickness="1" BorderBrush="#35EAF2FF">
              <Viewbox Width="18" Height="18">
                <Path Data="M2,7 L17,7 17,17 2,17 Z M17,10 L20,10 20,14 17,14 M6,12 L10,12"
                      Stroke="#D6E8FF" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Viewbox>
            </Border>
            <TextBlock Text="外设电量" Margin="10,0,0,0" Foreground="#F5F8FD" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Style="{StaticResource HeaderButton}" Click="RefreshClick"
                    ToolTip="刷新电量" AutomationProperties.Name="刷新电量">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource HeaderButton}" Click="MenuClick" ToolTip="菜单" AutomationProperties.Name="菜单">
              <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
            </Button>
            <Button Style="{StaticResource HeaderButton}" Click="HideClick" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘">
              <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="DeviceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="490">
          <StackPanel>
            <ItemsControl x:Name="DeviceList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="20" Margin="0,0,0,7" Padding="11,7,10,7" Background="#24D7E3F7"
                          BorderThickness="1" BorderBrush="#27E8F1FF" MouseRightButtonUp="DeviceMenuClick" ToolTip="{Binding Tooltip}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="49"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="12" Background="#2DD9E6FF" HorizontalAlignment="Left">
                        <Viewbox Width="17" Height="17">
                          <Path Data="{Binding Icon}" Stroke="#DCE8FA" StrokeThickness="1.6" StrokeLineJoin="Round"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#F6F8FD" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="#CCD6E7" FontSize="11" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <local:BatteryRing Grid.Column="2" Width="44" Height="44" Percent="{Binding Percent}" Accent="{Binding Accent}"
                                         Visibility="{Binding RingVisibility}"
                                         HorizontalAlignment="Right" AutomationProperties.Name="{Binding AccessibleLevel}"/>
                      <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#2DD9E6FF" CornerRadius="11" Padding="7,3" Margin="0,3,5,1">
                              <TextBlock Foreground="{Binding Accent}" Text="{Binding Text}" FontSize="11"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,14,4,16"
                       Foreground="#CCD6E7" FontSize="13"/>
          </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#C8D4E6" FontSize="11" Margin="3,5,2,0"
                   AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Grid>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="L" Width="10" HorizontalAlignment="Left" Margin="0,21" Cursor="SizeWE"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="R" Width="10" HorizontalAlignment="Right" Margin="0,21" Cursor="SizeWE"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="T" Height="10" VerticalAlignment="Top" Margin="21,0" Cursor="SizeNS"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="B" Height="10" VerticalAlignment="Bottom" Margin="21,0" Cursor="SizeNS"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="LT" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="RT" Width="21" Height="21" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="LB" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
    <Thumb Style="{StaticResource ResizeGrip}" Tag="RB" Width="21" Height="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
  </Grid>
</Window>
